{
  "name": "masthead",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-2.0-or-later",
  "description": "Editorial calendar for WordPress.",
  "scripts": {
    "build": "wp-scripts build client/index.js --output-path=build",
    "lint": "wp-scripts lint-js client tests/js tests/e2e scripts --no-error-on-unmatched-pattern && wp-scripts lint-style 'client/**/*.scss'",
    "test:unit": "wp-scripts test-unit-js --config jest.config.js",
    "test:integration": "npm run build && wp-env start && wp-env run tests-cli --env-cwd=wp-content/plugins/masthead vendor/bin/phpunit -c phpunit.integration.xml.dist"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@wordpress/api-fetch": "^8.1.0",
    "@wordpress/components": "^44.0.0",
    "@wordpress/core-data": "^9.1.0",
    "@wordpress/data": "^11.1.0",
    "@wordpress/date": "^6.1.0",
    "@wordpress/dom-ready": "^5.1.0",
    "@wordpress/element": "^10.1.0",
    "@wordpress/env": "^12.1.0",
    "@wordpress/i18n": "^7.1.0",
    "@wordpress/scripts": "^35.0.0"
  },
  "overrides": {
    "serialize-javascript": "^7.1.4",
    "linkify-it": "^6.1.0",
    "uuid": "^14.0.3"
  }
}
