{
  "verify": [
    "composer lint",
    "composer test:unit",
    {
      "cmd": "npm run lint",
      "from": "P0-02"
    },
    {
      "cmd": "npm run test:unit",
      "from": "P0-02"
    },
    {
      "cmd": "bash scripts/forbidden-patterns.sh",
      "from": "P0-03"
    }
  ],
  "extraVerify": {
    "src/": [
      {
        "cmd": "npm run test:integration",
        "timeoutMs": 1500000,
        "exclusive": true,
        "from": "P0-05"
      }
    ],
    "masthead.php": [
      {
        "cmd": "npm run test:integration",
        "timeoutMs": 1500000,
        "exclusive": true,
        "from": "P0-05"
      }
    ],
    "tests/integration/": [
      {
        "cmd": "npm run test:integration",
        "timeoutMs": 1500000,
        "exclusive": true,
        "from": "P0-05"
      }
    ],
    "client/": [
      {
        "cmd": "npm run build",
        "from": "P0-02"
      },
      {
        "cmd": "npm run test:e2e",
        "timeoutMs": 2400000,
        "exclusive": true,
        "from": "P1-14"
      }
    ],
    "tests/e2e/": [
      {
        "cmd": "npm run test:e2e",
        "timeoutMs": 2400000,
        "exclusive": true,
        "from": "P1-14"
      }
    ],
    "tests/e2e/smoke/": [
      {
        "cmd": "npm run test:e2e:smoke",
        "timeoutMs": 2400000,
        "exclusive": true,
        "from": "P0-06"
      }
    ],
    "scripts/release/": [
      {
        "cmd": "npm run release:pack",
        "timeoutMs": 900000,
        "from": "P0-07"
      }
    ]
  },
  "build": [
    "npm run build"
  ],
  "baseBranch": "main",
  "branchPrefix": "build/",
  "maxRounds": 3,
  "maxRoundsHard": 6,
  "policies": {
    "signing": "required"
  },
  "flight": "masthead",
  "mutation": {
    "targeted": {
      "php": {
        "cmd": "vendor/bin/phpunit -c phpunit.xml.dist --filter {filter}"
      }
    }
  },
  "constraints": [
    {
      "id": "no-front-end",
      "description": "SPEC 3.1: Masthead adds nothing to public pages. No front-end hook name may appear as a word in PHP (get_the_excerpt() and admin_enqueue_scripts stay legal).",
      "paths": [
        "src/",
        "masthead.php"
      ],
      "from": "P0-01",
      "pattern": "(?<![\\w])(wp_head|wp_footer|wp_enqueue_scripts|template_redirect|the_content|the_excerpt|render_block\\w*|pre_get_posts)(?![\\w])",
      "shouldMatch": [
        "add_action( 'wp_head', array( $this, 'head' ) );",
        "add_filter( \"the_content\", $callback );",
        "add_action( 'wp_enqueue_scripts', $callback );",
        "add_filter( 'render_block_core/list', $callback );",
        "add_action( 'pre_get_posts', array( $this, 'filter_query' ) );",
        "$html = apply_filters( 'the_excerpt', $text );",
        "add_action( 'template_redirect', $callback );",
        "add_action( 'wp_footer', $callback );"
      ],
      "shouldNotMatch": [
        "add_action( 'admin_enqueue_scripts', array( $this, 'enqueue' ) );",
        "$excerpt = get_the_excerpt( $post );",
        "wp_enqueue_script( 'masthead' );",
        "$text = $post->post_excerpt;"
      ]
    },
    {
      "id": "stats-confined",
      "description": "SPEC 3.1: WPCOM_Stats and every Automattic\\Jetpack\\Stats symbol appear only in src/Stats/JetpackStats.php.",
      "paths": [
        "src/",
        "masthead.php"
      ],
      "exclude": [
        "src/Stats/JetpackStats.php"
      ],
      "from": "P0-01",
      "pattern": "WPCOM_Stats|Jetpack\\\\+Stats",
      "flags": "i",
      "shouldMatch": [
        "use Automattic\\Jetpack\\Stats\\WPCOM_Stats;",
        "$client = new \\Automattic\\Jetpack\\Stats\\WPCOM_Stats();",
        "if ( class_exists( 'Automattic\\\\Jetpack\\\\Stats\\\\WPCOM_Stats' ) ) {",
        "$stats = new WPCOM_Stats();",
        "use Automattic\\Jetpack\\Stats\\Options;"
      ],
      "shouldNotMatch": [
        "use Masthead\\Stats\\StatsSource;",
        "$source = Factory::make();",
        "return new JetpackStats();",
        "'source' => __( 'Jetpack Stats', 'masthead' ),"
      ]
    },
    {
      "id": "social-confined",
      "description": "SPEC 3.1: the word publicize (any case) appears only in src/Social/JetpackSocial.php.",
      "paths": [
        "src/",
        "masthead.php"
      ],
      "exclude": [
        "src/Social/JetpackSocial.php"
      ],
      "from": "P0-01",
      "pattern": "publicize",
      "flags": "i",
      "shouldMatch": [
        "$request = new \\WP_REST_Request( 'GET', '/wpcom/v2/publicize/connections' );",
        "use Automattic\\Jetpack\\Publicize\\Connections;",
        "if ( ! class_exists( 'Jetpack_Publicize' ) ) {",
        "// Asks Publicize for the connection list."
      ],
      "shouldNotMatch": [
        "use Masthead\\Social\\ShareSource;",
        "$share = $this->share->share_now( $post_id, $message, $ids );",
        "return new JetpackSocial();"
      ]
    },
    {
      "id": "ai-confined",
      "description": "SPEC 3.1: wp_ai_client_prompt is called only in src/Ai/WpAiClient.php.",
      "paths": [
        "src/",
        "masthead.php"
      ],
      "exclude": [
        "src/Ai/WpAiClient.php"
      ],
      "from": "P0-01",
      "pattern": "wp_ai_client_prompt",
      "shouldMatch": [
        "$builder = wp_ai_client_prompt( $user );",
        "return \\wp_ai_client_prompt( $user )->generate_text();",
        "if ( function_exists( 'wp_ai_client_prompt' ) ) {"
      ],
      "shouldNotMatch": [
        "$result = $this->ai->json( $system, $user, $schema, 'fast' );",
        "return current_user_can( 'prompt_ai' );",
        "use Masthead\\Ai\\AiClient;"
      ]
    },
    {
      "id": "no-direct-http",
      "description": "SPEC 3.1: no direct HTTP in the plugin; all network traffic goes through Jetpack or the WordPress AI Client.",
      "paths": [
        "src/",
        "masthead.php"
      ],
      "from": "P0-01",
      "pattern": "(?<![\\w])(wp_remote_|wp_safe_remote_|curl_|fsockopen|stream_socket_client)|(file_get_contents|fopen)\\s*\\(\\s*['\"]\\s*https?",
      "shouldMatch": [
        "$response = wp_remote_get( $url );",
        "$response = wp_safe_remote_post( $url, $args );",
        "$handle = curl_init( $url );",
        "$socket = fsockopen( $host, $port );",
        "$body = file_get_contents( 'https://example.com/a.json' );",
        "$handle = fopen( \"http://example.com\", 'r' );",
        "$code = \\wp_remote_retrieve_response_code( $response );"
      ],
      "shouldNotMatch": [
        "$json = file_get_contents( $path );",
        "$response = rest_do_request( $request );",
        "$handle = fopen( $file, 'r' );"
      ]
    },
    {
      "id": "client-endpoints",
      "description": "SPEC 3.1: client JS talks only to wp/v2/* and the core Abilities run endpoint.",
      "paths": [
        "client/"
      ],
      "from": "P0-01",
      "pattern": "wpcom/|jetpack/|admin-ajax\\.php",
      "flags": "i",
      "shouldMatch": [
        "apiFetch( { path: '/wpcom/v2/publicize/connections' } );",
        "const path = '/jetpack/v4/module/stats';",
        "fetch( ajaxurl || '/wp-admin/admin-ajax.php' );",
        "const url = `${ root }wpcom/v3/stats`;"
      ],
      "shouldNotMatch": [
        "apiFetch( { path: '/wp/v2/posts/' + id, method: 'POST', data } );",
        "const path = `/wp-abilities/v1/abilities/${ name }/run`;",
        "const label = __( 'Connections come from Jetpack Social', 'masthead' );"
      ]
    },
    {
      "id": "writes-confined",
      "description": "SPEC 3.1: wp_insert_post, wp_update_post and wp_delete_post appear only in src/Plan/Slots.php and src/Plan/Reschedule.php.",
      "paths": [
        "src/",
        "masthead.php"
      ],
      "exclude": [
        "src/Plan/Slots.php",
        "src/Plan/Reschedule.php"
      ],
      "from": "P0-01",
      "pattern": "(?<![\\w])wp_(insert|update|delete|trash|publish)_post(?![\\w])",
      "shouldMatch": [
        "$post_id = wp_insert_post( $postarr, true );",
        "wp_update_post( array( 'ID' => $post_id, 'post_date' => $date ) );",
        "\\wp_delete_post( $post_id, true );",
        "wp_trash_post( $post_id );",
        "wp_publish_post( $post_id );",
        "$callback = 'wp_insert_post';"
      ],
      "shouldNotMatch": [
        "$post_id = $this->slots->create( $input );",
        "update_post_meta( $post_id, 'masthead_last_shared', $iso );",
        "add_filter( 'wp_insert_post_data', $callback );",
        "$result = $this->reschedule->move( $post_id, $date, $time );"
      ]
    },
    {
      "id": "cron-read-only",
      "description": "SPEC 3.1: nothing under src/Cron/ writes posts, post meta or terms, runs an ability, or imports a module that can. The reviewer also reads src/Cron/Nightly.php.",
      "paths": [
        "src/Cron/"
      ],
      "from": "P0-01",
      "pattern": "(?<![\\w])(wp_(insert|update|delete|trash|publish)_post|wp_set_(post|object)_terms|wp_insert_term|wp_update_term|(update|add|delete)_(post|term)_meta|wp_get_ability)(?![\\w])|Masthead\\\\+(Abilities|Plan|Social|Ai|Cli|Admin)\\\\|->(execute|share_now|share_at|create|move)\\s*\\(",
      "shouldMatch": [
        "wp_update_post( array( 'ID' => $id ) );",
        "update_post_meta( $id, 'masthead_planned', true );",
        "$ability = wp_get_ability( 'masthead/reschedule' );",
        "$ability->execute( $input );",
        "use Masthead\\Plan\\Reschedule;",
        "use Masthead\\Abilities\\Registrar;",
        "$this->share->share_now( $post_id, $message, $ids );",
        "wp_set_post_terms( $id, $terms, 'category' );",
        "update_term_meta( $term_id, 'masthead_lane_exception', true );"
      ],
      "shouldNotMatch": [
        "use Masthead\\Desk\\SwapCheck;",
        "use Masthead\\Stats\\StatsSource;",
        "update_option( self::OPTION, $payload, false );",
        "$findings = $this->swap_check->run( $from, $to );",
        "do_action( 'masthead_findings_updated', count( $findings ) );"
      ]
    },
    {
      "id": "no-secrets-stored",
      "description": "SPEC 3.1: no option, meta or transient name contains key, token, secret or password. Covers the name argument of the option, transient, meta and register_setting calls and name constants; the reviewer also reads names built at runtime.",
      "paths": [
        "src/",
        "masthead.php"
      ],
      "from": "P0-01",
      "pattern": "\\w*(option|transient)\\s*\\(\\s*['\"][^'\"]*(key|token|secret|password)|\\w*_meta\\s*\\(\\s*[^,()]+,\\s*['\"][^'\"]*(key|token|secret|password)|register_setting\\s*\\(\\s*['\"][^'\"]*['\"]\\s*,\\s*['\"][^'\"]*(key|token|secret|password)|(option|meta|transient)\\w*\\s*=\\s*['\"][^'\"]*(key|token|secret|password)",
      "flags": "i",
      "shouldMatch": [
        "$value = get_option( 'masthead_api_key' );",
        "update_option( \"masthead_ai_token\", $token );",
        "set_transient( 'masthead_secret_cache', $data, $ttl );",
        "update_post_meta( $post_id, 'masthead_share_token', $value );",
        "register_post_meta( 'post', 'masthead_password_hint', $args );",
        "register_setting( 'masthead', 'masthead_provider_key', $args );",
        "private const OPTION = 'masthead_api_secret';",
        "$meta_name = 'masthead_token';",
        "$data = get_user_meta( $user_id, 'masthead_dismissed_keys', true );"
      ],
      "shouldNotMatch": [
        "$value = get_option( 'masthead_settings', array() );",
        "$meta = get_post_meta( $post_id, $key, true );",
        "set_transient( $transient, $data, Config::get( 'stats.cache_ttl' ) );",
        "private const OPTION = 'masthead_findings';",
        "$max = Config::get( 'ai.max_tokens' );",
        "$data = get_user_meta( $user_id, 'masthead_dismissed', true );",
        "register_setting( 'masthead', 'masthead_rhythm', $args );"
      ]
    },
    {
      "id": "no-key-reads",
      "description": "SPEC 3.1: Masthead never reads provider credentials or the process environment. Use wp_get_environment_type() for the environment type.",
      "paths": [
        "src/",
        "client/",
        "masthead.php"
      ],
      "from": "P0-01",
      "pattern": "ANTHROPIC_API_KEY|OPENROUTER_API_KEY|(?<![\\w])getenv\\s*\\(|\\$_ENV\\b|process\\.env",
      "shouldMatch": [
        "$key = getenv( 'ANTHROPIC_API_KEY' );",
        "if ( defined( 'OPENROUTER_API_KEY' ) ) {",
        "$type = getenv( 'WP_ENVIRONMENT_TYPE' );",
        "$type = \\getenv( 'WP_ENVIRONMENT_TYPE' );",
        "$value = $_ENV['WP_ENVIRONMENT_TYPE'];",
        "const key = process.env.ANTHROPIC_API_KEY;"
      ],
      "shouldNotMatch": [
        "$type = wp_get_environment_type();",
        "return current_user_can( 'prompt_ai' );",
        "$supported = $this->ai->supported();"
      ]
    },
    {
      "id": "one-clock",
      "description": "SPEC 3.2: the only clock is Masthead\\Support\\Clock. No PHP time or date function, no `new DateTime*` and no createFromFormat() without a leading ! (which would fill missing fields from the wall clock) outside src/Support/Clock.php. DateTimeImmutable::createFromFormat( '!...' ) and ->format() or ->modify() on an existing object stay legal; methods named date() or time() do not. The reviewer also reads for relative strings such as 'now' passed to ->modify().",
      "paths": [
        "src/",
