    {
      "id": "bounded-queries",
      "description": "SPEC 3.2: every query is bounded. The reviewer also checks by reading that each WP_Query sets no_found_rows => true unless it paginates.",
      "paths": [
        "src/",
        "client/",
        "masthead.php"
      ],
      "from": "P0-01",
      "pattern": "(posts_per_page|numberposts|per_page|perPage)['\"]?\\s*\\]?\\s*(=>|:|=)\\s*-\\s*1|nopaging['\"]?\\s*\\]?\\s*(=>|:|=)\\s*(true|1)|['\"]number['\"]\\s*\\]?\\s*(=>|=)\\s*(0|''|\"\"|false|null)(?![\\w.])",
      "flags": "i",
      "shouldMatch": [
        "'posts_per_page' => -1,",
        "\"posts_per_page\" => - 1,",
        "'nopaging' => true,",
        "'numberposts' => -1,",
        "'number' => 0,",
        "$args['posts_per_page'] = -1;",
        "per_page: -1,",
        "const query = { perPage: -1 };",
        "'number' => '',",
        "$args['nopaging'] = true;"
      ],
      "shouldNotMatch": [
        "'posts_per_page' => Config::get( 'calendar.max_posts_per_range' ),",
        "'no_found_rows' => true,",
        "'number' => Config::get( 'desk.candidate_pool' ),",
        "per_page: boot.config.maxPostsPerRange,",
        "'nopaging' => false,"
      ]
    },
    {
      "id": "stat-render-confined",
      "description": "SPEC 3.3: every stat value in the UI renders through client/components/StatValue.js; no other client file reads views, visitors or visits.",
      "paths": [
        "client/"
      ],
      "exclude": [
        "client/components/StatValue.js"
      ],
      "from": "P0-01",
      "pattern": "\\??\\.\\s*(avg_?)?(views|visitors|visits)\\b|\\[\\s*['\"](avg_)?(views|visitors|visits)['\"]\\s*\\]|(const|let|var)\\s*\\{[^}]*\\b(avg_?)?(views|visitors|visits)\\b",
      "flags": "i",
      "shouldMatch": [
        "const n = stat.views;",
        "return <span>{ post.views }</span>;",
        "const v = finding.numbers?.values?.visitors;",
        "const n = row[ 'visits' ];",
        "const { views } = stat;",
        "const { source, avg_views } = day;",
        "total += day.avgViews;"
      ],
      "shouldNotMatch": [
        "return <StatValue stat={ finding.numbers } name=\"category\" />;",
        "const numbers = finding.numbers;",
        "import StatValue from '../components/StatValue';",
        "const label = __( 'Views come from Jetpack Stats', 'masthead' );"
      ]
    },
    {
      "id": "dangerous-php",
      "description": "SPEC 3.4: no eval, unserialize, extract, create_function, assert, system, exec, shell_exec, passthru or proc_open in the plugin.",
      "paths": [
        "src/",
        "masthead.php"
      ],
      "from": "P0-01",
      "pattern": "(?<![\\w])(eval|unserialize|maybe_unserialize|extract|create_function|assert|system|exec|shell_exec|passthru|proc_open|popen|pcntl_exec)\\s*\\(",
      "shouldMatch": [
        "eval( $code );",
        "$data = unserialize( $raw );",
        "extract( $args );",
        "$fn = create_function( '$a', 'return $a;' );",
        "assert( $value > 0 );",
        "system( 'ls' );",
        "exec( $command, $output );",
        "$out = shell_exec( $command );",
        "passthru( $command );",
        "$proc = proc_open( $command, $spec, $pipes );",
        "$data = maybe_unserialize( $raw );",
        "$out = \\shell_exec( $command );"
      ],
      "shouldNotMatch": [
        "$result = $ability->execute( $input );",
        "$data = json_decode( $raw, true );",
        "$this->assert_valid( $input );",
        "$ecosystem = get_option( 'masthead_settings' );"
      ]
    }
  ]
