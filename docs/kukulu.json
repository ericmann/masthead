      "shouldMatch": [
        "$now = time();",
        "$today = date( 'Y-m-d' );",
        "$stamp = gmdate( 'c' );",
        "$label = wp_date( 'M j', $timestamp );",
        "$now = current_time( 'mysql' );",
        "$now = current_datetime();",
        "$ts = strtotime( $date );",
        "$dt = new DateTime( $date );",
        "$dt = new \\DateTimeImmutable( 'now', wp_timezone() );",
        "$tz = new DateTimeZone( 'UTC' );",
        "$started = microtime( true );",
        "$dt = date_create( $date );",
        "$ts = \\time();",
        "public function date( string $value ): string {",
        "$dt = \\DateTimeImmutable::createFromFormat( 'Y-m-d', $date, wp_timezone() );",
        "$ago = human_time_diff( $then );"
      ],
      "shouldNotMatch": [
        "$now = Clock::now();",
        "$dt = \\DateTimeImmutable::createFromFormat( '!Y-m-d', $date, wp_timezone() );",
        "$label = $dt->format( 'Y-m-d' );",
        "$gmt = get_gmt_from_date( $local );",
        "$next = $dt->modify( '+1 day' );",
        "$version = filemtime( $path );",
        "$label = Clock::format( $dt, 'M j' );",
        "$iso = mysql2date( 'c', $post->post_date, false );",
        "$ttl = Config::get( 'stats.cache_ttl' );",
        "$now = apply_filters( 'masthead_now', $real );",
        "if ( ! $this->validate( $input ) ) {",
        "$ok = checkdate( $month, $day, $year );",
        "$modified = get_post_time( 'Y-m-d', false, $post );",
        "$pin = $assoc_args['now'] ?? null;",
        "'now' => Dates::to_iso( Clock::now() ),"
      ]
    },
    {
      "id": "client-clock",
