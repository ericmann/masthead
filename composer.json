{
	"name": "ericmann/masthead",
	"description": "Editorial calendar, Desk suggestions and swap checks for WordPress.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.3"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"brain/monkey": "^2.6",
		"yoast/phpunit-polyfills": "^2.0",
		"squizlabs/php_codesniffer": "^3.10",
		"wp-coding-standards/wpcs": "^3.1",
		"automattic/vipwpcs": "^3.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"autoload": {
		"psr-4": {
			"Masthead\\": "src/"
		},
		"files": [
			"src/constants.php"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"Masthead\\Tests\\": "tests/",
			"Masthead\\Tests\\Unit\\": "tests/unit/",
			"Masthead\\Tests\\Integration\\": "tests/integration/"
		}
	},
	"config": {
		"platform": {
			"php": "8.3.0"
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": [
			"find masthead.php src tests -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null",
			"phpcs"
		],
		"test:unit": "phpunit -c phpunit.xml.dist"
	}
}
